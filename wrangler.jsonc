{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dreams-of-times-carpe-diem",
  "compatibility_date": "2026-09-08",
  "observability": {
    "enabled": true
  },
  "main": "worker/index.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "COMPANION_CHAT_KV",
      // ★「wrangler kv namespace create COMPANION_CHAT_KV」を実行して発行されたidに書き換えてください
      //   （詳しくはREADME_COMPANION_CHAT.mdを参照）
      "id": "4d5d5aa19a7c47d7b88d826fd50161d0"
    }
  ]
}
